allow url http://adam.chlipala.net/style.css
allow url http://2017-dalby.flaretiming.com/styles.css
allow url /comp*
allow url /main*
allow url http://flaretiming.com
allow url http://flaretiming.com/posts/2018-12-19-add-a-comp.html
allow url http://www.impredicative.com/ur/
allow url http://www.blockscope.com
allow url http://www.flaretiming.com/about.html
allow url http://www.flaretiming.com/disclaim.html
allow url http://www.flaretiming.com/blog.html
allow url https://www.openstreetmap.org/copyright
allow meta charset
allow meta viewport
allow mime text/css
safeGet comp
safeGet compSettings
safeGet compPilots
rewrite style Bulma/tabular table
rewrite style Bulma/titular title
rewrite style Bulma/* [-]
rewrite url CompView/widget comp
rewrite url CompView/widgetSettings compSettings
rewrite url CompView/widgetPilots compPilots
rewrite url Main/*
library comp-json/compJson

bulma
footer
compView
home
main
