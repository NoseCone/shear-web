allow url http://adam.chlipala.net/style.css
rewrite style Css/quote quote
rewrite url Site/*
link compFetch.o
link compParse.o
link parson.o
link -lcurl
include compFetch.h
include compParse.h
ffi compFetch
ffi compParse
effectful CompFetch.fetch
effectful CompParse.parse
effectful CompParse.free
benignEffectful CompParse.civilId
benignEffectful CompParse.earthMath
benignEffectful CompParse.discipline
benignEffectful CompParse.location
benignEffectful CompParse.fromDate
benignEffectful CompParse.toDate
benignEffectful CompParse.compName
benignEffectful CompParse.utcOffsetMinutes
benignEffectful CompParse.earthRadius
benignEffectful CompParse.giveDistance
benignEffectful CompParse.giveFraction
benignEffectful CompParse.scoreBack

comp
compJson
fetch
site
